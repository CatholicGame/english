/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# raw scraped source material for content-generation scripts (~350MB of audio) —
# audio is uploaded to Vercel Blob by scripts/upload-listen-a-minute-audio.mjs and
# the derived text/timing data lives in src/data/listen-a-minute.ts (committed);
# this folder itself never needs to leave the machine that ran the pipeline
/src/assets/listening_a_minute/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# local yt-dlp binary + scratch downloads from scripts/download-soundcloud-audio.mjs
/.bin/
/downloads/

.env*
